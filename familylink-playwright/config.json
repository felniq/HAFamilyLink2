{
  "name": "Google Family Link Auth 2",
  "version": "1.9.0",
  "slug": "familylink-playwright",
  "description": "Authentication service for Google Family Link integration using browser automation",
  "url": "https://github.com/felniq/HAFamilyLink2",
  "image": "ghcr.io/noiwid/familylink-auth",
  "arch": [
    "amd64",
    "aarch64"
  ],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "ports": {
    "8098/tcp": 8098,
    "6079/tcp": 6079
  },
  "ports_description": {
    "8098/tcp": "Web interface for Google authentication. Never expose it to the internet",
    "6079/tcp": "noVNC browser view, protected by the VNC password. Unmap it when you are not authenticating"
  },
  "map": [
    "share:rw"
  ],
  "options": {
    "log_level": "info",
    "auth_timeout": 300,
    "session_duration": 86400,
    "language": "",
    "timezone": "",
    "vnc_password": ""
  },
  "schema": {
    "log_level": "list(trace|debug|info|warning|error)?",
    "auth_timeout": "int(60,600)?",
    "session_duration": "int(3600,604800)?",
    "language": "str?",
    "timezone": "str?",
    "vnc_password": "password?"
  },
  "webui": "http://[HOST]:[PORT:8098]",
  "host_network": false,
  "hassio_api": true,
  "hassio_role": "default"
}
